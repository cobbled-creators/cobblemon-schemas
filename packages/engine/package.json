{
  "name": "@cobbled-creators/cobblemon-validator",
  "version": "0.1.0",
  "description": "Validates Cobblemon datapack and resource pack files against a @cobbled-creators/cobblemon-schemas package: works out which schema a file uses and reports one plain error per problem, with positions.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cobbled-creators/cobblemon-schemas.git",
    "directory": "packages/engine"
  },
  "homepage": "https://github.com/cobbled-creators/cobblemon-schemas/tree/main/packages/engine#readme",
  "bugs": {
    "url": "https://github.com/cobbled-creators/cobblemon-schemas/issues"
  },
  "keywords": [
    "cobblemon",
    "minecraft",
    "datapack",
    "json-schema",
    "validation"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.mjs"
    },
    "./node": {
      "types": "./src/node.d.ts",
      "default": "./src/node.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "jsonc-parser": "3.3.1"
  }
}
