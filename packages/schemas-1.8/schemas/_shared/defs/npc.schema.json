{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cobblemon-schema.local/_shared/defs/npc.schema.json",
  "title": "Cobblemon Shared NPC Definitions",
  "type": "object",
  "$defs": {
    "variableDefinition": {
      "type": "object",
      "properties": {
        "variableName": {
          "type": "string",
          "default": "variable"
        },
        "category": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "additionalProperties": true
            }
          ],
          "default": "Variables"
        },
        "displayName": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "additionalProperties": true
            }
          ],
          "default": "Variable"
        },
        "description": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "additionalProperties": true
            }
          ],
          "default": "A variable that can be used in the entity's configuration."
        },
        "type": {
          "type": "string",
          "enum": [
            "NUMBER",
            "TEXT",
            "BOOLEAN"
          ],
          "default": "NUMBER"
        },
        "defaultValue": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "type": "number"
            },
            {
              "type": "integer"
            }
          ],
          "default": "0"
        }
      },
      "additionalProperties": false
    }
  }
}
