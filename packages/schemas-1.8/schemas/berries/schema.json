{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cobblemon-schema.local/berries/schema.json",
  "title": "Cobblemon Berry",
  "type": "object",
  "properties": {
    "baseYield": {
      "$ref": "../_shared/defs/ranges.schema.json#/$defs/intMinMax"
    },
    "preferredBiomeTags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "growthTime": {
      "$ref": "../_shared/defs/ranges.schema.json#/$defs/intMinMax"
    },
    "refreshRate": {
      "$ref": "../_shared/defs/ranges.schema.json#/$defs/intMinMax"
    },
    "favoriteMulches": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "growthFactors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "variant": {
            "type": "string",
            "enum": [
              "cobblemon:preferred_biome",
              "cobblemon:biome_downfall",
              "cobblemon:biome_temperature"
            ]
          },
          "bonusYield": {
            "$ref": "../_shared/defs/ranges.schema.json#/$defs/intMinMax"
          },
          "range": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "object",
                "properties": {
                  "min": {
                    "type": "number"
                  },
                  "max": {
                    "type": "number"
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "variant",
          "bonusYield"
        ],
        "additionalProperties": true,
        "allOf": [
          {
            "if": {
              "properties": {
                "variant": {
                  "enum": [
                    "cobblemon:biome_downfall",
                    "cobblemon:biome_temperature"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "range"
              ]
            }
          }
        ]
      }
    },
    "spawnConditions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "variant": {
            "type": "string",
            "enum": [
              "cobblemon:preferred_biome",
              "cobblemon:all_biome",
              "cobblemon:specific_biome"
            ]
          },
          "biome": {
            "type": "string"
          },
          "minGroveSize": {
            "type": "integer",
            "minimum": 1
          },
          "maxGroveSize": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "variant"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "variant": {
                  "const": "cobblemon:specific_biome"
                }
              }
            },
            "then": {
              "required": [
                "biome"
              ]
            }
          }
        ]
      },
      "default": []
    },
    "growthPoints": {
      "type": "array",
      "items": {
        "$ref": "../_shared/defs/vectors.schema.json#/$defs/positioning"
      }
    },
    "randomizedGrowthPoints": {
      "type": "boolean",
      "default": false
    },
    "mutations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "sproutShape": {
      "type": "string"
    },
    "matureShape": {
      "type": "string"
    },
    "flavours": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "flavor": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "colour": {
      "type": "string"
    },
    "color": {
      "type": "string"
    },
    "tintIndexes": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "flowerModel": {
      "type": "string"
    },
    "flowerTexture": {
      "type": "string"
    },
    "fruitModel": {
      "type": "string"
    },
    "fruitTexture": {
      "type": "string"
    },
    "stageOnePositioning": {
      "$ref": "../_shared/defs/vectors.schema.json#/$defs/positioning"
    },
    "pokeSnackPositionings": {
      "type": "array",
      "items": {
        "$ref": "../_shared/defs/vectors.schema.json#/$defs/positioning"
      }
    },
    "weight": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "boneMealChance": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0
    }
  },
  "required": [
    "baseYield",
    "growthTime",
    "refreshRate",
    "favoriteMulches",
    "growthFactors",
    "growthPoints",
    "mutations",
    "sproutShape",
    "matureShape",
    "tintIndexes",
    "flowerModel",
    "flowerTexture",
    "fruitModel",
    "fruitTexture",
    "stageOnePositioning",
    "pokeSnackPositionings"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "anyOf": [
        {
          "required": [
            "flavours"
          ]
        },
        {
          "required": [
            "flavor"
          ]
        }
      ]
    },
    {
      "anyOf": [
        {
          "required": [
            "colour"
          ]
        },
        {
          "required": [
            "color"
          ]
        }
      ]
    },
    {
      "if": {
        "required": [
          "spawnConditions"
        ],
        "properties": {
          "spawnConditions": {
            "contains": {
              "properties": {
                "variant": {
                  "const": "cobblemon:preferred_biome"
                }
              },
              "required": [
                "variant"
              ]
            }
          }
        }
      },
      "then": {
        "required": [
          "preferredBiomeTags"
        ]
      }
    },
    {
      "if": {
        "required": [
          "spawnConditions"
        ],
        "properties": {
          "spawnConditions": {
            "minItems": 1
          }
        }
      },
      "then": {
        "required": [
          "weight"
        ]
      }
    }
  ]
}
