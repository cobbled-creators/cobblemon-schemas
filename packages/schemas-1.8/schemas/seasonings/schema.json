{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cobblemon-schema.local/seasonings/schema.json",
  "title": "Cobblemon Seasoning",
  "type": "object",
  "properties": {
    "ingredient": {
      "anyOf": [
        {
          "$ref": "../_shared/defs/identifiers.schema.json#/$defs/identifier"
        },
        {
          "$ref": "../_shared/defs/identifiers.schema.json#/$defs/tagIdentifier"
        }
      ]
    },
    "colour": {
      "type": "string"
    },
    "color": {
      "type": "string"
    },
    "flavours": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "flavors": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "baitEffects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "subcategory": {
            "type": "string"
          },
          "chance": {
            "type": "number",
            "default": 0
          },
          "value": {
            "type": "number",
            "default": 0
          }
        },
        "required": [
          "type"
        ],
        "additionalProperties": false
      }
    },
    "food": {
      "type": "object",
      "properties": {
        "hunger": {
          "type": "integer",
          "default": 0
        },
        "saturation": {
          "type": "number",
          "default": 0
        }
      },
      "additionalProperties": false
    },
    "mobEffects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "effect": {
            "$ref": "../_shared/defs/identifiers.schema.json#/$defs/identifier"
          },
          "duration": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          },
          "amplifier": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          },
          "ambient": {
            "type": "boolean",
            "default": false
          },
          "visible": {
            "type": "boolean",
            "default": false
          },
          "showIcon": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "effect"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "ingredient"
  ],
  "additionalProperties": false,
  "anyOf": [
    {
      "required": [
        "colour"
      ]
    },
    {
      "required": [
        "color"
      ]
    }
  ]
}
