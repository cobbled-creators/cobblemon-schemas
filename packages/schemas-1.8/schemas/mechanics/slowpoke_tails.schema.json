    "canShearSlowpoke": { "type": "boolean", "default": true },
    "onlyRegrowWhenSentOut": { "type": "boolean", "default": false },
    "regrowthSeconds": { "type": "integer", "minimum": 0, "default": 1200 },
    "aspectThresholds": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "default": {}
    }
  },
  "additionalProperties": false
}
