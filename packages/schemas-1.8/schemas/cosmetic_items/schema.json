{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cobblemon-schema.local/cosmetic_items/schema.json",
  "title": "Cobblemon Cosmetic Item Assignment",
  "type": "object",
  "properties": {
    "pokemon": {
      "type": "array",
      "items": {
        "$ref": "../_shared/defs/pokemon.schema.json#/$defs/pokemonProperties"
      },
      "default": []
    },
    "cosmeticItems": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "consumedItem": {
            "$ref": "../_shared/defs/pokemon.schema.json#/$defs/registryLikeCondition",
            "default": "cobblemon:poke_ball"
          },
          "aspects": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          }
        },
        "additionalProperties": false
      },
      "default": []
    }
  },
  "additionalProperties": false
}
