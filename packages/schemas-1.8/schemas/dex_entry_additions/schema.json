{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cobblemon-schema.local/dex_entry_additions/schema.json",
  "title": "Cobblemon Dex Entry Addition",
  "type": "object",
  "properties": {
    "entryId": {
      "$ref": "../_shared/defs/identifiers.schema.json#/$defs/identifier",
      "default": "cobblemon:some_addition"
    },
    "forms": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "displayForm": {
            "type": "string",
            "default": "Normal"
          },
          "unlockForms": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          }
        },
        "additionalProperties": false
      }
    },
    "variations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "default": "cobblemon.pokedex.variation.cosmetic"
          },
          "icon": {
            "type": "string",
            "default": "cobblemon:textures/gui/pokedex/variation/cosmetic.png"
          },
          "aspects": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}