{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cobblemon-schema.local/spawn_rules/schema.json",
  "title": "Cobblemon Spawn Rule",
  "type": "object",
  "properties": {
    "displayName": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": true
        }
      ],
      "default": "Spawn Rule"
    },
    "enabled": {
      "$ref": "../_shared/defs/expressions.schema.json#/$defs/booleanLike",
      "default": true
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component"
      },
      "default": []
    }
  },
  "additionalProperties": false,
  "$defs": {
    "spawnDetailSelector": {
      "oneOf": [
        {
          "$ref": "../_shared/defs/expressions.schema.json#/$defs/expressionLike"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "expression"
              ]
            },
            "expression": {
              "$ref": "../_shared/defs/expressions.schema.json#/$defs/expressionLike"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        }
      ]
    },
    "spawnablePositionSelector": {
      "oneOf": [
        {
          "$ref": "../_shared/defs/expressions.schema.json#/$defs/expressionLike"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "expression",
                "conditional"
              ]
            },
            "expression": {
              "$ref": "../_shared/defs/expressions.schema.json#/$defs/expressionLike",
              "default": "true"
            },
            "conditions": {
              "type": "array",
              "items": {
                "$ref": "../_shared/defs/spawning.schema.json#/$defs/spawningCondition"
              },
              "default": []
            },
            "anticonditions": {
              "type": "array",
              "items": {
                "$ref": "../_shared/defs/spawning.schema.json#/$defs/spawningCondition"
              },
              "default": []
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "componentBase": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "weight",
            "filter",
            "location"
          ]
        },
        "spawnDetailSelector": {
          "$ref": "#/$defs/spawnDetailSelector"
        },
        "spawnSelector": {
          "$ref": "#/$defs/spawnDetailSelector"
        },
        "spawnablePositionSelector": {
          "$ref": "#/$defs/spawnablePositionSelector"
        },
        "contextSelector": {
          "$ref": "#/$defs/spawnablePositionSelector"
        },
        "allow": {
          "$ref": "../_shared/defs/expressions.schema.json#/$defs/expressionLike",
          "default": "true"
        },
        "weight": {
          "$ref": "../_shared/defs/expressions.schema.json#/$defs/expressionLike",
          "default": "v.weight"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "component": {
      "allOf": [
        {
          "$ref": "#/$defs/componentBase"
        },
        {
          "oneOf": [
            {
              "properties": {
                "type": {
                  "const": "weight"
                },
                "allow": false
              }
            },
            {
              "properties": {
                "type": {
                  "const": "filter"
                },
                "weight": false
              }
            },
            {
              "properties": {
                "type": {
                  "const": "location"
                },
                "weight": false,
                "spawnDetailSelector": false,
                "spawnSelector": false,
                "spawnablePositionSelector": false,
                "contextSelector": false
              }
            }
          ]
        }
      ]
    }
  }
}
